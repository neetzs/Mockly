# ==============================================================================
# MOCKLY - CONFIGURACIÓN DE VARIABLES DE ENTORNO LOCALES
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL 17)
# Coincide con docker-compose.yml y la ConnectionString de WebApi
# ------------------------------------------------------------------------------
POSTGRES_USER=mockly_admin
POSTGRES_PASSWORD=mockly_secure_password_2026
POSTGRES_DB=mockly_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Seguridad y Tokens (JWT)
# La clave secreta debe tener mínimo 32 bytes (256 bits) para HMAC-SHA256
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=clave_super_secreta_mockly_desarrollo_2026_segura_32_bytes
JWT_ISSUER=MocklyApi
JWT_AUDIENCE=MocklyClient

# ------------------------------------------------------------------------------
# 3. Motor de Inteligencia Artificial (Microsoft.Extensions.AI)
# Proveedor compatible con OpenAI / Azure OpenAI / Ollama local
# ------------------------------------------------------------------------------
AI_API_KEY=tu_api_key_aqui # Aca pondria la API Key... Si tan solo la tuviera...
AI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Frontend (Vite + React 19)
# Variables consumidas por import.meta.env
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5067/api/v1
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/interview